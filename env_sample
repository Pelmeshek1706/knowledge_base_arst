# GraphRAG demo configuration (local LM Studio model)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=airestairest

# Local model endpoint (LM Studio, OpenAI-compatible API)
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=mlx-qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_EMBED_FALLBACK=true
LOCAL_EMBED_DIMENSIONS=384
# LMSTUDIO_API_KEY=

# StateGraph agent runtime (LangChain-native model layer)
AGENT_RUNTIME=stategraph
AGENT_MODEL=mlx-qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
AGENT_BASE_URL=http://localhost:1234
AGENT_API_KEY=lm-studio
AGENT_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
AGENT_WEB_BUDGET=2
AGENT_DEEP_LINK_BUDGET=1
AGENT_GRAPH_PNG_PATH=graphrag_app/artifacts/agent_stategraph.png
AGENT_GRAPH_MERMAID_PATH=graphrag_app/artifacts/agent_stategraph.mmd

# Optional absolute path to source JSON file
DATA_JSON=/Users/pelmeshek1706/Desktop/projects/knowledge_agent/data/data.json

# Chunking
CHUNK_MODE=context
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Cache location
PROCESSED_DOCS_DIR=processed_docs

# Hybrid retrieval
NEO4J_VECTOR_INDEX=chunk_embedding_index
NEO4J_VECTOR_SIMILARITY=cosine
VECTOR_TOP_K=6
HYBRID_SEED_RRF_K=60
HYBRID_CONTEXT_SEED_LIMIT=16
HYBRID_CONTEXT_NEIGHBOR_LIMIT=24
HYBRID_RERANK_VECTOR_WEIGHT=0.55
HYBRID_RERANK_GRAPH_WEIGHT=0.25
HYBRID_RERANK_TERM_WEIGHT=0.20
HYBRID_RERANK_SEED_BOOST=0.10

# LangSmith tracing (LangChain/LangGraph observability) - optional
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=knowledge-agent-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TAGS=local,lmstudio,graphrag

